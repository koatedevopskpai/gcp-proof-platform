# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo
.npm/

# .NET
bin/
obj/
*.user
*.suo
TestResults/

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/crash.log

# GCP / gcloud
.env
# Keep local keys and service-account files out of git. (Comments must be on their own line: git has no inline
# comments, so an earlier version of this rule matched nothing at all.)
*.json
!infra/terraform/**/schemas/*.json
!mlops/model-registry/*.json
!services/**/package.json
!services/**/package-lock.json
!services/**/tsconfig.json
!services/**/appsettings*.json
!services/evaluator/tests/fixtures/*.json
!evidence/**/*.json

# Local run outputs (reproducible; evidence worth keeping is copied under evidence/)
artifacts/

# Helm
infra/helm/**/charts/*.tgz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local dev docs
*CODE-ALONG*.txt
# Personal / office documents - never publish a CV or application paperwork
*.docx
*.dotx
*CV*.pdf
*CV*.doc

# Terraform plan artefacts (binary, never commit)
tfplan*
*.tfplan

# The plain-English project overview is kept outside this repository (DOCX/PDF), never published
docs/overview.md
docs/overview*.md
overview/
