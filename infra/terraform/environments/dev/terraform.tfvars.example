budget_owner         = "platform-leads"
workload             = "gcp-proof-platform"
cost_category        = "engineering-rnd"
data_classification  = "public-reference"

# Budget guardrail (hard $20/month)
budget_limit_gbp = 15
budget_alerts_email = "koatekpai@outlook.com"