# Copy to .env and fill in the project.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

AGENT_MODEL=gemini-3-flash-preview
RAG_API_URL=http://localhost:8010

# Phase-2 local defaults: synthetic assets and a JSONL escalation file.
# Set both to `bigquery` for a deployed service.
ASSETS_SOURCE=memory
ESCALATION_SINK=file
ESCALATION_FILE=artifacts/escalations.jsonl

# BQ_PROJECT defaults to GOOGLE_CLOUD_PROJECT when empty.
# BQ_PROJECT=
# ASSETS_DATASET=ai_platform
# ESCALATIONS_DATASET=agent_ops
